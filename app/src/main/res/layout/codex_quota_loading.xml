<?xml version="1.0" encoding="utf-8"?>
<!-- Shown only until Glance composes the real card. A failed/deferred Glance render used to
     leave this as an invisible dark box ("the widget shows nothing"); a visible placeholder
     makes that state readable instead. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/codex_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Codex Quota"
            android:textColor="#8E8E93"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="加载中…"
            android:textColor="#8E8E93"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
